#!/bin/sh
# Global pre-commit: block commits on main/master (Agent.md section 5).
# Detached HEAD is allowed (it does not move main/master).
branch=$(git symbolic-ref --short -q HEAD)
case "$branch" in
  main|master)
    echo "BLOCKED by git hook: commit on $branch is not allowed. Create a work branch first: git switch -c feat/<module>" >&2
    exit 1 ;;
esac
# Run the repository's own pre-commit hook if one exists (core.hooksPath hides it from Git).
local_hook="$(git rev-parse --git-common-dir)/hooks/pre-commit"
if [ -f "$local_hook" ]; then
  "$local_hook" "$@" || { echo "BLOCKED by git hook: repository pre-commit hook failed: $local_hook" >&2; exit 1; }
fi
exit 0
